{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/editor.html"
    },
    {
      "source": "/v/:slug",
      "destination": "/api/view?slug=:slug"
    },
    {
      "source": "/:slug((?!api$|editor$)[a-zA-Z0-9-]+)",
      "destination": "/api/view?slug=:slug"
    }
  ]
}

